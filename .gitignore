# ========== 训练输出 ==========
logs/
checkpoints/
*.zip
*.pt
*.pth

# ========== Python 缓存 ==========
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# ========== 环境/IDE ==========
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ========== API 密钥（重要！） ==========
.env
*.env.local
api_key.txt
openai_key.txt

# ========== 数据集 ==========
data/
*.pkl
*.csv
*.jsonl

# ========== 临时文件 ==========
*.tmp
*.log
~$*

# ========== 父目录 .gitignore 有 `env/` 规则，需要显式恢复 src/env/ ==========
!src/env/
!src/env/**
