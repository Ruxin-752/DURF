# Required only for the protected research export endpoint.
ADMIN_EXPORT_TOKEN=replace-with-a-long-random-secret

# Optional in production when the public origin differs from request.url.
# Use only the scheme + host (+ port), with no path.
SITE_ORIGIN=https://durf-kitchen-lab.example.com

# Optional internal feedback pipeline. Defaults to pragmatic route1; allowed: route1 or route2.
# This is deployment configuration and is not exposed as a player control.
NEXT_PUBLIC_FEEDBACK_ROUTE=route1
