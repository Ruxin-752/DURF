    "group_id": "root_authored_evaluative_trajectory_1",
    "source": "new_synthetic_seed_v3",
    "human_data": false
  },
  {
    "text": "The way you waited for me was considerate.",
    "speech_act": "evaluative",
    "grounding": "trajectory",
    "group_id": "root_authored_evaluative_trajectory_2",
    "source": "new_synthetic_seed_v3",
    "human_data": false
  },
  {
    "text": "You made a mess of that delivery.",
